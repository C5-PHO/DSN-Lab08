# Copy to .env and set unique secrets. Never commit .env.
APP_SECRET=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
BASE_URL=http://127.0.0.1:8088
DATABASE=instance/techstore.sqlite3
COOKIE_SECURE=false
# Set to id -u and id -g when using Docker with the local database.
LOCAL_UID=1000
LOCAL_GID=1000

# Optional: enable after creating OAuth applications.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
